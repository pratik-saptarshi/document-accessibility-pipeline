{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/dap/remediation/profile.schema.json",
  "title": "Remediation profile with separately accepted PDF/UA target",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "lane",
    "family",
    "language",
    "confidentiality",
    "retention",
    "accessibility",
    "pdfua_target",
    "human_review",
    "source_fields"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "status": {
      "const": "proposed"
    },
    "lane": {
      "const": "remediation"
    },
    "family": {
      "enum": [
        "statements",
        "invoices",
        "correspondence",
        "reports"
      ]
    },
    "language": {
      "$ref": "#/$defs/decision"
    },
    "confidentiality": {
      "$ref": "#/$defs/decision"
    },
    "retention": {
      "$ref": "#/$defs/decision"
    },
    "accessibility": {
      "$ref": "#/$defs/decision"
    },
    "pdfua_target": {
      "$ref": "#/$defs/pdfuaTarget"
    },
    "human_review": {
      "$ref": "#/$defs/decision"
    },
    "source_fields": {
      "description": "Field names must be unique within a profile. Consumers must enforce uniqueness by name; uniqueItems only rejects identical field objects.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/field"
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "pdfuaTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "status"],
      "properties": {
        "value": {"type": "string", "minLength": 1, "pattern": "[^\\t-\\r \u0085\u00A0\u1680\u2000-\u200A\u2028\u2029\u202F\u205F\u3000]"},
        "status": {"enum": ["accepted", "proposed", "open"]}
      },
      "if": {"properties": {"status": {"const": "accepted"}}},
      "then": {"properties": {"value": {"const": "PDF/UA-2"}}}
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "status"
      ],
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1,
          "pattern": "[^\\t-\\r \u0085\u00A0\u1680\u2000-\u200A\u2028\u2029\u202F\u205F\u3000]"
        },
        "status": {
          "enum": [
            "proposed",
            "open"
          ]
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "status"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "^(?:[\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000]|[\\s\\S]*[\\u0009-\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000](?![\\s\\S]))"
          }
        },
        "type": {
          "enum": [
            "string",
            "number",
            "date",
            "boolean",
            "unknown"
          ]
        },
        "status": {
          "enum": [
            "proposed",
            "open"
          ]
        }
      }
    }
  }
}
