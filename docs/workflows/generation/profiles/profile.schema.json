              ]
            }
          }
            ]
          }
        }
      }
    },
    {
      "description": "Decision 0014 section 1 requires the marketing family to carry these source fields. Mirrors internal/profile familyRequiredFields; the Go validator is the authoritative gate.",
      "if": {
